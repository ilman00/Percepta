<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="#">Percepta Exchange</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
          <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
          <li class="nav-item"><a class="nav-link" href="#download">Download</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="bg-light text-center py-5">
    <div class="container">
      <h1 class="display-4 mb-3"><%= message %></h1>
      <p class="lead mb-4">Exchange currencies instantly with your mobile app. Secure, fast, and reliable.</p>
      <a href="#download" class="btn btn-primary btn-lg">Get the App</a>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">App Features</h2>
      <div class="row text-center">
        <div class="col-md-3 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title">Instant Exchange</h5>
              <p class="card-text">Convert currencies in real-time with live rates.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title">Secure Transactions</h5>
              <p class="card-text">Bank-level security for all your transactions.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title">Multi-Currency Wallet</h5>
              <p class="card-text">Store multiple currencies in your app wallet safely.</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title">24/7 Support</h5>
              <p class="card-text">Get help anytime with in-app customer support.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="bg-light py-5">
    <div class="container">
      <h2 class="text-center mb-5">How It Works</h2>
      <div class="row align-items-center">
        <div class="col-md-6 mb-4">
          <img src="/images/app-screenshot.png" alt="App Screenshot" class="img-fluid rounded shadow">
        </div>
        <div class="col-md-6">
          <ul class="list-group list-group-flush">
            <li class="list-group-item">1. Sign up and verify your account</li>
            <li class="list-group-item">2. Add currencies to your wallet</li>
            <li class="list-group-item">3. Exchange currencies instantly</li>
            <li class="list-group-item">4. Withdraw or spend directly from the app</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Download Section -->
  <section id="download" class="py-5 text-center">
    <div class="container">
      <h2 class="mb-4">Download the App</h2>
      <p class="mb-4">Available on Android and iOS</p>
      <a href="#" class="btn btn-success btn-lg me-2">Google Play</a>
      <a href="#" class="btn btn-dark btn-lg">App Store</a>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="bg-primary text-white py-5">
    <div class="container text-center">
      <h2>Contact Us</h2>
      <p>Email: support@perceptaexchange.com</p>
      <p>Phone: +92 300 0000000</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-3">
    &copy; <%= new Date().getFullYear() %> Percepta Exchange. All rights reserved.
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
